#--------------------------------------------
# Setting
#--------------------------------------------

# OpenAI canonical reviewer
export OPENAI_API_KEY=""

# GitHub
export GH_TOKEN=""

export CODEX_BIN="$(find "$HOME/.vscode/extensions" -path '*/openai.chatgpt-*/bin/macos-aarch64/codex' -type f | sort | tail -1)"
export PATH="$(dirname "$CODEX_BIN"):$PATH"
